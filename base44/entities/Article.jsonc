{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Article title"
    },
    "category": {
      "type": "string",
      "enum": [
        "marriage-counseling-process",
        "effective-communication",
        "infidelity-trust",
        "growing-loving-relationship",
        "spouse-resists-counseling",
        "general"
      ],
      "description": "Article category"
    },
    "excerpt": {
      "type": "string",
      "description": "Brief excerpt or summary of the article"
    },
    "content": {
      "type": "string",
      "description": "Full article content in markdown format"
    },
    "order": {
      "type": "number",
      "description": "Display order within category"
    }
  },
  "required": [
    "title",
    "category",
    "content"
  ]
}